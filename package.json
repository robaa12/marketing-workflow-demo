{
  "name": "marketing-strategy-workflow",
  "version": "0.1.0",
  "description": "Production-ready marketing strategy workflow built on Mastra. Orchestrates six specialized agents (Product Analysis, STP, Buyer Persona, Buyer Journey, SMART Objectives, Campaign Planner) over a shared, strongly-typed context.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:mastra": "mastra build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "mastra dev",
    "dev:cli": "tsx src/index.ts",
    "server": "mastra dev",
    "server:legacy": "tsx src/server.ts",
    "studio": "mastra dev",
    "start": "mastra start",
    "start:mastra": "npm run start",
    "test": "vitest run",
    "test:rag": "vitest run tests/evals/projectKnowledge.eval.test.ts tests/lib/projectKnowledge.test.ts tests/lib/claimAudit.test.ts",
    "test:watch": "vitest"
  },
  "keywords": [
    "mastra",
    "marketing",
    "workflow",
    "agents",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@mastra/ai-sdk": "^1.7.0",
    "@mastra/core": "^1.54.0",
    "@mastra/duckdb": "^1.5.2",
    "@mastra/evals": "^1.6.0",
    "@mastra/libsql": "^1.18.0",
    "@mastra/observability": "^1.16.3",
    "@mastra/perplexity": "^0.2.0",
    "@mastra/pg": "^1.18.0",
    "@tavily/core": "^0.7.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "mastra": "^1.21.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
