# OpenCode Go is the default provider (via your subscription).
# Get your key at https://opencode.ai/settings/api
OPENCODE_API_KEY=sk-...

# Tavily API key for web search (free tier: 1000 searches/month).
# Get your key at https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Perplexity API key for AI-summarized search (optional, enhances research).
# Get your key at https://www.perplexity.ai/settings/api
# PERPLEXITY_API_KEY=pplx-...

# Optional: approved brand profiles used by the brand-context tool.
# Keep this JSON on one line; omit it when no profile is available.
# BRAND_CONTEXT_JSON=[{"brandName":"Insight Loop","voice":"direct, practical","approvedClaims":["Reports in 5 minutes, not 5 hours."],"prohibitedTerms":["guaranteed"],"toneExamples":["Show the time saved."],"assetUrls":[],"updatedAt":"2026-08-02T00:00:00.000Z"}]

# Optional: override the default model. Any Mastra-supported
# `provider/model` string works, e.g.
#   opencode-go/deepseek-v4-flash (default)
#   opencode-go/kimi-k2.6
#   openai/gpt-4o-mini
#   anthropic/claude-sonnet-4-6
# See https://mastra.ai/models for the full list.
# MASTRA_MODEL_DEFAULT=opencode-go/kimi-k2.6

# Persistent storage for run history, traces, and memory.
# Default is a local SQLite file under .mastra/ (created on first run).
# Override for Turso / production:
#   MASTRA_STORAGE_URL=file:./.mastra/marketing.db
#   MASTRA_STORAGE_URL=libsql://your-db.turso.io
# MASTRA_STORAGE_URL=

# Internal backend calls. Set the same secret in the Nest backend.
MASTRA_INTERNAL_TOKEN=replace-with-the-same-unique-secret-used-by-the-backend
# Project knowledge RAG.
RAG_ENABLED=false
# Required when RAG_ENABLED=true. PostgreSQL must have the pgvector extension.
# RAG_POSTGRES_URL=postgresql://postgres:postgres@localhost:5432/iti_grad
# RAG_POSTGRES_SCHEMA=rag
# RAG_POSTGRES_POOL_MAX=10
# Uses a local Ollama embedding service. Do not enable/pull the model until
# the local GPU/driver setup is ready.
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
# RAG_EMBEDDING_DIMENSIONS=768
# RAG_INDEX_VERSION=pgvector-v1

# Local DuckDB file used by Studio's Traces, Logs, and Metrics views.
# MASTRA_OBSERVABILITY_PATH=.mastra/observability.duckdb

# Hard deadline for one complete structured-generation operation (15,000–300,000 ms).
# The default is 90,000 ms and includes fallback/correction attempts.
# MASTRA_AGENT_TIMEOUT_MS=90000

# Per-query deadline for bounded STP research (3,000–30,000 ms).
# MASTRA_RESEARCH_TIMEOUT_MS=15000
